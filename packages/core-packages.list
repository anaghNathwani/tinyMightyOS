# TinyMightyOS Core Package List
# These are built from source during the base system build.
# Format: name|version|source_url|build_flags

# ── Libc ──────────────────────────────────────────────────────────────────────
musl|1.2.5|https://musl.libc.org/releases/musl-1.2.5.tar.gz|--enable-wrapper=all

# ── Core utils ────────────────────────────────────────────────────────────────
busybox|1.36.1|https://busybox.net/downloads/busybox-1.36.1.tar.bz2|CONFIG_STATIC=y
util-linux|2.40.2|https://mirrors.edge.kernel.org/pub/linux/utils/util-linux/v2.40/util-linux-2.40.2.tar.xz|
coreutils|9.5|https://ftp.gnu.org/gnu/coreutils/coreutils-9.5.tar.xz|--without-gmp
findutils|4.10.0|https://ftp.gnu.org/gnu/findutils/findutils-4.10.0.tar.xz|
grep|3.11|https://ftp.gnu.org/gnu/grep/grep-3.11.tar.xz|
sed|4.9|https://ftp.gnu.org/gnu/sed/sed-4.9.tar.xz|
gawk|5.3.0|https://ftp.gnu.org/gnu/gawk/gawk-5.3.0.tar.xz|
diffutils|3.10|https://ftp.gnu.org/gnu/diffutils/diffutils-3.10.tar.xz|
less|653|https://www.greenwoodsoftware.com/less/less-653.tar.gz|
file|5.45|https://astron.com/pub/file/file-5.45.tar.gz|
which|2.21|https://savannah.gnu.org/projects/which/|

# ── Shell ─────────────────────────────────────────────────────────────────────
bash|5.2|https://ftp.gnu.org/gnu/bash/bash-5.2.tar.gz|--without-bash-malloc
dash|0.5.12|http://gondor.apana.org.au/~herbert/dash/files/dash-0.5.12.tar.gz|

# ── Compression ───────────────────────────────────────────────────────────────
zstd|1.5.6|https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-1.5.6.tar.gz|
xz|5.6.2|https://github.com/tukaani-project/xz/releases/download/v5.6.2/xz-5.6.2.tar.xz|
gzip|1.13|https://ftp.gnu.org/gnu/gzip/gzip-1.13.tar.xz|
bzip2|1.0.8|https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz|
lz4|1.9.4|https://github.com/lz4/lz4/releases/download/v1.9.4/lz4-1.9.4.tar.gz|

# ── Filesystem ────────────────────────────────────────────────────────────────
e2fsprogs|1.47.1|https://downloads.sourceforge.net/project/e2fsprogs/e2fsprogs/v1.47.1/e2fsprogs-1.47.1.tar.gz|
btrfs-progs|6.9.1|https://mirrors.edge.kernel.org/pub/linux/kernel/people/kdave/btrfs-progs/btrfs-progs-v6.9.1.tar.xz|
dosfstools|4.2|https://github.com/dosfstools/dosfstools/releases/download/v4.2/dosfstools-4.2.tar.gz|
parted|3.6|https://ftp.gnu.org/gnu/parted/parted-3.6.tar.xz|

# ── Network ───────────────────────────────────────────────────────────────────
iproute2|6.9.0|https://mirrors.edge.kernel.org/pub/linux/utils/net/iproute2/iproute2-6.9.0.tar.xz|
curl|8.8.0|https://curl.se/download/curl-8.8.0.tar.xz|--with-ssl --with-zstd
wget|1.21.4|https://ftp.gnu.org/gnu/wget/wget-1.21.4.tar.gz|--with-ssl=openssl
openssh|9.8p1|https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-9.8p1.tar.gz|
wireguard-tools|1.0.20210914|https://git.zx2c4.com/wireguard-tools/snapshot/wireguard-tools-1.0.20210914.tar.xz|
iptables|1.8.10|https://netfilter.org/projects/iptables/files/iptables-1.8.10.tar.xz|
nftables|1.1.0|https://netfilter.org/projects/nftables/files/nftables-1.1.0.tar.xz|
dnsmasq|2.90|https://thekelleys.org.uk/dnsmasq/dnsmasq-2.90.tar.gz|

# ── Security ──────────────────────────────────────────────────────────────────
openssl|3.3.1|https://openssl.org/source/openssl-3.3.1.tar.gz|no-tests
libseccomp|2.5.5|https://github.com/seccomp/libseccomp/releases/download/v2.5.5/libseccomp-2.5.5.tar.gz|

# ── Development ───────────────────────────────────────────────────────────────
gcc|14.1.0|https://ftp.gnu.org/gnu/gcc/gcc-14.1.0/gcc-14.1.0.tar.xz|
binutils|2.42|https://ftp.gnu.org/gnu/binutils/binutils-2.42.tar.xz|
make|4.4.1|https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz|
cmake|3.30.1|https://github.com/Kitware/CMake/releases/download/v3.30.1/cmake-3.30.1.tar.gz|
git|2.45.2|https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.45.2.tar.xz|
strace|6.9|https://github.com/strace/strace/releases/download/v6.9/strace-6.9.tar.xz|

# ── Text editors ──────────────────────────────────────────────────────────────
neovim|0.10.0|https://github.com/neovim/neovim/archive/refs/tags/v0.10.0.tar.gz|
vim|9.1|https://github.com/vim/vim/archive/refs/tags/v9.1.0.tar.gz|

# ── System ────────────────────────────────────────────────────────────────────
procps|4.0.4|https://sourceforge.net/projects/procps-ng/files/Production/procps-4.0.4.tar.xz|
htop|3.3.0|https://github.com/htop-dev/htop/releases/download/3.3.0/htop-3.3.0.tar.xz|
lsof|4.99.3|https://github.com/nicowillis/lsof/archive/4.99.3.tar.gz|
psmisc|23.7|https://gitlab.com/psmisc/psmisc/-/archive/v23.7/psmisc-v23.7.tar.gz|
shadow|4.16.0|https://github.com/shadow-maint/shadow/releases/download/4.16.0/shadow-4.16.0.tar.xz|
sudo|1.9.15|https://www.sudo.ws/dist/sudo-1.9.15p5.tar.gz|

# ── Bootloader ────────────────────────────────────────────────────────────────
grub|2.12|https://ftp.gnu.org/gnu/grub/grub-2.12.tar.xz|--target=x86_64-efi --with-platform=efi
syslinux|6.03|https://mirrors.edge.kernel.org/pub/linux/utils/boot/syslinux/syslinux-6.03.tar.xz|
